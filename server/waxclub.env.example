# Configuração da API do WaxClub (api.waxclub.com.br).
# Este arquivo vai FORA da pasta pública, com o nome waxclub.env, em:
#   /home/u999655947/domains/waxclub.com.br/waxclub.env
# (no Gerenciador de Arquivos do hPanel: pasta domains > waxclub.com.br, ao lado de public_html).
# Não coloque este arquivo no GitHub com a senha preenchida.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=u999655947_waxclub
DB_USER=u999655947_waxclub
DB_PASS=

# Remetente dos códigos de login = caixa de e-mail criada no hPanel (a única do plano: waxclub@)
MAIL_FROM=waxclub@waxclub.com.br
SMTP_USER=waxclub@waxclub.com.br
# Senha dessa caixa: com ela o e-mail sai pelo SMTP da Hostinger, assinado (DKIM) e fora do spam
SMTP_PASS=

# Login com Google: Client ID(s) do Google Cloud, separados por vírgula (deixe vazio até criar)
GOOGLE_CLIENT_IDS=

# WaxBrain: senha que criptografa as chaves de IA dos usuários no banco. Pelo menos 32 caracteres
# aleatórios (ideal: 64 hexadecimais), gerados uma vez e NUNCA trocados (trocar torna as chaves guardadas ilegíveis).
# Vazio = as chaves ficam só no celular de cada usuário.
BRAIN_SECRET=
